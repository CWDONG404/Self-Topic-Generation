# 复制为 .env 后再启动。正式使用时务必替换以下密钥和数据库密码。
APP_SECRET=replace-with-a-long-random-secret-at-least-32-characters
POSTGRES_DB=studyforge
POSTGRES_USER=studyforge
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# 中国大陆网络可使用以下镜像加速首次构建；删除或改为官方地址即可切回。
APT_MIRROR_ROOT=https://mirrors.tuna.tsinghua.edu.cn
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

WEB_PORT=3000
API_PORT=8000
DATABASE_URL=postgresql+psycopg://studyforge:replace-with-a-strong-database-password@postgres:5432/studyforge
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
STORAGE_DIR=/data
APP_TIMEZONE=Asia/Shanghai

# 上传与解析限制
MAX_UPLOAD_MB=200
MAX_DOCUMENT_PAGES=2000
# Kimi 深度思考和本地模型冷启动可能较慢；正式出题默认允许单次等待 5 分钟。
MODEL_REQUEST_TIMEOUT_SECONDS=300
MODEL_REQUEST_MAX_RETRIES=2
VISUAL_ENRICHMENT_MAX_NEW_ASSETS_PER_JOB=8
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info

# 可选的部署级硬限制；true 时即使前端选择云端模式也会被后端拒绝。
STRICT_LOCAL_MODE=false
